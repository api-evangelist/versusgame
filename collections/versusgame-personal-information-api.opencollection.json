{
  "opencollection": "1.0.0",
  "info": {
    "name": "Versusgame Personal Information API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "personal-information",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PersonalController_byId",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/personal-information",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "PersonalController_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/personal-information",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}