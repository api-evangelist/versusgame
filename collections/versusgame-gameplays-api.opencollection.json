          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/gameplays/:id",
            "headers": [
              {
                "name": "x-idempotency-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
