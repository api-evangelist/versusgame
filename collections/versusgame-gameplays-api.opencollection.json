              },
              {
                "name": "gameId",
                "value": "",
                "type": "query"
              },
              {
                "name": "asc",
                "value": "",
                "type": "query"
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "GameplaysController_create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/gameplays",
            "headers": [
              {
                "name": "x-idempotency-key",
                "value": ""
              }
